<?xml version="1.0" encoding="utf-8"?>
<!--
  PLANTILLA PARA CONEXIÓN CON USUARIO SA (crear la base de datos desde la API)

  Uso:
  1. Copiá este archivo como: connectionStrings.secrets.config
  2. Reemplazá YourSaPassword por la contraseña real del usuario sa.
  3. NUNCA versiones connectionStrings.secrets.config (agregalo a .gitignore si no está).
  4. En Web.config reemplazá la sección <connectionStrings> por:
     <connectionStrings configSource="connectionStrings.secrets.config" />

  Así la API usará el usuario sa para conectar y podrá ejecutar el script
  de creación de base de datos (CrearBaseDatosYTablas.sql) cuando uses
  la configuración inicial.
-->
<connectionStrings>
  <add name="DataContext"
       connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=smartlunch;User ID=sa;Password=YourSaPassword;Pooling=True;Min Pool Size=5;Max Pool Size=100;Connect Timeout=30;Encrypt=True;TrustServerCertificate=True"
       providerName="System.Data.SqlClient" />
</connectionStrings>
