<?xml version="1.0" encoding="utf-8"?>
<!--
  PLANTILLA DE SECRETOS - NO CONTIENE VALORES REALES

  Uso:
  1. Copiá este archivo como: appSettings.secrets.config
  2. Reemplazá los value="" por las claves reales de cada entorno.
  3. NUNCA versiones appSettings.secrets.config (está en .gitignore).
  4. Web.config tiene <appSettings file="appSettings.secrets.config">; en ejecución
     estas claves se fusionan con las de Web.config.

  Keys que van SOLO en este archivo (nunca en Web.config versionado):

  | Key               | Descripción                                      | Usado en                          |
  |-------------------|--------------------------------------------------|-----------------------------------|
  | JwtSecret              | Clave simétrica para firmar/validar JWT (≥32 chars) | Startup, AuthService, ServicioLogin, LoginController |
  | JwtExpirationHours     | Horas de validez del token JWT (ej. 10)             | ServicioLogin, AuthService, LoginController         |
  | SmartTimePassword      | Contraseña usuario integración SmartTime          | ServicioSmartTime                 |
  | BiostarPassword        | Contraseña usuario integración Biostar           | BiostarController                 |
  | CorsAllowedOrigins     | Orígenes permitidos para CORS (URL del frontend)  | Startup, CorsHeadersMiddleware    |
  | ScriptRunnerKey        | Clave de acceso al panel de scripts pendientes (api/DbScripts) | DbScriptsController  |
  | BiostarSyncKey         | Clave que manda el tótem en el header X-Biostar-Key para poder sincronizar fichadas | BiostarController |
-->
<appSettings>
  <add key="JwtSecret" value="" />
  <!-- Horas hasta que expire el token JWT. Si no se define aquí, se usa el valor de Web.config. -->
  <add key="JwtExpirationHours" value="10" />
  <!-- Días hasta que expire el refresh token (por defecto 7). -->
  <add key="JwtRefreshTokenExpirationDays" value="7" />
  <add key="SmartTimePassword" value="" />
  <add key="BiostarPassword" value="" />
  <!-- URL(s) desde donde se abre el frontend. Varios orígenes separados por coma. Sin barra final. -->
  <add key="CorsAllowedOrigins" value="http://localhost:4200,https://tu-servidor.com" />
  <!-- Clave para entrar al panel de scripts pendientes (api/DbScripts). Generar un valor propio; si queda vacía, el panel no deja acceder. -->
  <add key="ScriptRunnerKey" value="" />
  <!-- Clave que debe mandar el tótem en el header X-Biostar-Key para POST /api/biostar/events. Generar un valor propio; si queda vacía, el endpoint rechaza todo. -->
  <add key="BiostarSyncKey" value="" />
</appSettings>
