<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <appSettings file="appSettings.secrets.config">
    <add key="DatabaseName" value="smartlunch2026" />
    <add key="DatabaseSchemaScriptPath" value="Scripts\CrearBaseDatosYTablas.sql" />
    <add key="UsuarioSmatTime" value="Comensal" />
    <add key="smarTime" value="true" />
    <add key="SmartTimeLoginPath" value="/Seguridad/LoginAplicacion" />
    <add key="SmartTimeDatoLaboralPath" value="/DatoLaboral" />
    <add key="SmartimeBaseUrl" value="https://swagger.sintaryc.com/api" />
    <add key="SmartimeListaConLectorPath" value="/api/fichada/listaConLector" />
    <add key="SmartimeZonaHoraria" value="Argentina Standard Time" />
    <add key="SmartTimeAuthHeader" value="" />
    <add key="SmartTimeUsuario" value="IT_FICHADA" />
    <add key="SmartTimeNombreApp" value="ITARSA_PRD" />
    <add key="SmartTimeKey" value="ArsaProd" />
    <add key="SmartTimeEmpresa" value="1" />
    <add key="SmartTimeTraza" value="traza" />
    <add key="SmartTimeAplicacionOrigen" value="swagger" />
    <add key="Biostar" value="true" />
    <add key="BiostarBaseUrl" value="https://172.16.41.29:4433" />
    <add key="BiostarLoginPath" value="/api/login" />
    <add key="BiostarEventsPath" value="/api/events/search" />
    <add key="BiostarUser" value="smartlunch" />
    <add key="BiostarDefaultMinutesBack" value="5" />
    <add key="BiostarDefaultDeviceId" value="865718937" />
    <add key="BiostarDefaultEventId" value="4118" />
    <add key="BiostarHttpTimeoutSeconds" value="60" />
    <add key="Bonificaciones" value="1" />
    <add key="Bonificaciones_invitado" value="0" />
    <add key="Plan_nutricional" value="2" />
    <add key="Planta" value="1" />
    <add key="Centro_costo" value="5" />
    <add key="Proyecto" value="1" />
    <add key="Jerarquia" value="3" />
    <add key="tipoVisualizacionCodigo" value="Barra" />
    <add key="JwtIssuer" value="SmartLunchApi" />
    <add key="JwtAudience" value="SmartLunchFront" />
    <add key="JwtRefreshTokenExpirationDays" value="7" />
    <add key="CorsAllowedHeaders" value="Content-Type,Authorization,Accept,Origin,Cache-Control,Pragma,Expires,X-Requested-With,X-Request-Time" />
    <add key="CorsAllowedMethods" value="GET,POST,PUT,DELETE,OPTIONS" />
    <add key="RateLimitMaxAttempts" value="5" />
    <add key="RateLimitWindowMinutes" value="15" />
    <add key="RateLimitBlockMinutes" value="10" />
    <add key="RateLimitCleanupIntervalMinutes" value="60" />
    <add key="LogPath" value="~/App_Data/Logs" />
    <add key="LogLevel" value="Information" />
    <add key="IncludeStackTraceInLogs" value="false" />
    <add key="JwtAdminJerarquiaIds" value="1" />
    <add key="PlatosImagenesRelativePath" value="/uploads/platos" />
    <add key="PlatosImagenesBaseUrl" value="C:/Noelia/SmartLunch/SmartLunchSecureApi" />
    <!-- SmartTimePassword, BiostarPassword y JwtSecret NO van acá: son secretos reales y
         viven solo en appSettings.secrets.config (gitignoreado), que ASP.NET mergea solo. -->
    <add key="ScriptRunnerKey" value="" />
    <add key="CorsAllowedOrigins" value="http://localhost:8000,http://localhost:3000,http://localhost:4200" />
    <add key="JwtExpirationHours" value="10" />
  </appSettings>
  <!--
    Para obtener una descripción de los cambios de web.config, vea http://go.microsoft.com/fwlink/?LinkId=235367.

    Los siguientes atributos se pueden establecer en la etiqueta <httpRuntime>.
      <system.Web>
        <httpRuntime targetFramework="4.8.1" />
      </system.Web>
  -->
